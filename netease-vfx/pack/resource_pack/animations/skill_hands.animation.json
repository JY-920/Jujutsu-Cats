            "95.0+20.0*query.mod.jujutsuvfx_hand_charge+10.0*query.mod.jujutsuvfx_hand_red",
            "-45.0+20.0*query.mod.jujutsuvfx_hand_charge+8.0*query.mod.jujutsuvfx_hand_void+15.0*query.mod.jujutsuvfx_hand_fuga",

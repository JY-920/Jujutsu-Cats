// __multiversion__
precision highp float;
#include "fragmentVersionCentroidUV.h"
#include "uniformWorldConstants.h"
LAYOUT_BINDING(0) uniform sampler2D TEXTURE_0;
LAYOUT_BINDING(1) uniform sampler2D TEXTURE_1;
LAYOUT_BINDING(2) uniform sampler2D TEXTURE_2;
uniform vec4 EXTRA_VECTOR1; // camera yaw/pitch, domain age, fade
uniform vec4 EXTRA_VECTOR2; // domain centre relative to camera in world axes, radius
uniform vec4 EXTRA_VECTOR3; // aspect, tan half fov, focus, flash enabled
uniform vec4 EXTRA_VECTOR4; // own horizon direction, clash
float h(vec3 p){return fract(sin(dot(p,vec3(127.1,311.7,74.7)))*43758.5453);}
float n(vec3 p){vec3 a=floor(p),f=fract(p);f=f*f*(3.0-2.0*f);return mix(mix(mix(h(a),h(a+vec3(1,0,0)),f.x),mix(h(a+vec3(0,1,0)),h(a+vec3(1,1,0)),f.x),f.y),mix(mix(h(a+vec3(0,0,1)),h(a+vec3(1,0,1)),f.x),mix(h(a+vec3(0,1,1)),h(a+vec3(1,1,1)),f.x),f.y),f.z);}
float fb(vec3 p){return .54*n(p)+.27*n(p*2.08)+.13*n(p*4.21)+.06*n(p*8.17);}
float dep(float d){return abs(PROJ[3][2]/max(.000001,abs(d*2.0-1.0+PROJ[2][2])));}
vec3 clouds(vec3 ray,float t){
    float billow=fb(ray*5.0+vec3(t*.025,0,t*.019));
    float fold=fb(ray*11.0+vec3(billow*3.0,t*.023,0));
    return mix(vec3(.075,.002,.009),vec3(.92,.008,.035),smoothstep(.23,.76,billow))+
        vec3(.34,.006,.01)*pow(max(0.0,fold),3.0);
}
void main(){
    vec4 src=texture2D(TEXTURE_0,uv);float yaw=EXTRA_VECTOR1.x,pitch=EXTRA_VECTOR1.y,t=EXTRA_VECTOR1.z;
    vec3 f=vec3(sin(yaw)*cos(pitch),sin(pitch),cos(yaw)*cos(pitch));
    vec3 right=normalize(cross(f,vec3(0,1,0))),up=cross(right,f);
    vec2 q=(uv*2.0-1.0)*vec2(EXTRA_VECTOR3.x,1.0)*EXTRA_VECTOR3.y;
    vec3 ray=normalize(f+right*q.x+up*q.y),center=EXTRA_VECTOR2.xyz;
    float raw=texture2D(TEXTURE_2,uv).r,terrain=raw>.99999?100000.0:dep(raw);
    float skyMask=step(.99998,raw);vec3 red=clouds(ray,t);
    vec3 result=mix(src.rgb,red,skyMask);
    // A world-plane water surface, softly feathered over the final eight blocks.
    float waterHeight=center.y+.025;
    float travel=abs(ray.y)>.00001?waterHeight/ray.y:-1.0;
    if(travel>0.0){
        vec3 at=ray*travel,delta=at-center;
        float radial=length(delta.xz),radius=EXTRA_VECTOR2.w;
        float edge=1.0-smoothstep(max(1.0,radius-8.0),radius,radial);
        float front=step(travel*dot(ray,f),terrain+.12);
        vec2 wave=vec2(sin(at.x*.62+t*.7+sin(at.z*.4)),cos(at.z*.67-t*.56+sin(at.x*.2)))*.015;
        vec3 normal=normalize(vec3(wave.x,1,wave.y));
        vec3 reflected=reflect(ray,normal);
        float billow=fb(reflected*5.5+vec3(t*.014,0,0));
        vec3 water=mix(vec3(.006,.045,.09),vec3(.01,.47,.57),smoothstep(.18,.82,billow));
        water+=vec3(.04,.26,.3)*pow(max(0.0,fb(reflected*15.0)),4.0);
        // Depth-tested screen-space reflection of geometry already visible in this
        // frame. Missing off-screen information falls back to the procedural sky.
        vec3 viewPoint=vec3(dot(at,right),dot(at,up),dot(at,f));
        vec3 viewRay=vec3(dot(reflected,right),dot(reflected,up),dot(reflected,f));
        float found=0.0;
        for(int i=1;i<=12;i++){
            float stepLength=float(i)*float(i)*.12;
            vec3 p=viewPoint+viewRay*stepLength;
            if(p.z>.08&&found<.5){
                vec2 st=p.xy/p.z/(vec2(EXTRA_VECTOR3.x,1.0)*EXTRA_VECTOR3.y)*.5+.5;
                if(st.x>.01&&st.x<.99&&st.y>.01&&st.y<.99){
                    float sd=texture2D(TEXTURE_2,st).r;
                    float z=dep(sd),diff=p.z-z;
                    if(sd<.99998&&diff>-.10&&diff<.9){
                        vec3 reflection=texture2D(TEXTURE_1,st).rgb;
                        float edgeFade=smoothstep(.0,.08,min(min(st.x,1.0-st.x),min(st.y,1.0-st.y)));
                        water=mix(water,reflection*vec3(.46,.85,.96),.65*edgeFade);found=1.0;
                    }
                }
            }
        }
        float horizon=pow(1.0-abs(ray.y),4.0);
        water=mix(water,red*.7,horizon*.46);
        result=mix(result,water,edge*front*.96);
    }
    float focus=EXTRA_VECTOR3.z;
    if(focus>.5){
        float monochrome=1.0-smoothstep(.55,.65,t);
        float reveal=smoothstep(.64,.82,t);
        vec3 silhouette=mix(src.rgb*.018,vec3(1.0,.002,.005),skyMask);
        result=mix(result,silhouette,reveal);
        result=mix(result,vec3(.0),monochrome);
        float flash=exp(-abs(t-.65)*55.0)*EXTRA_VECTOR3.w;
        result=mix(result,vec3(1),flash*.95);
    }
    float mask=EXTRA_VECTOR4.w>.5?smoothstep(-.13,.13,dot(ray,normalize(EXTRA_VECTOR4.xyz+vec3(0,0,.0001)))):1.0;
    // No period of normal sky when this opens inside Unlimited Void.
    float entry=mix(smoothstep(0.0,.35,t),1.0,EXTRA_VECTOR4.w);
    result=mix(src.rgb,result,mask*EXTRA_VECTOR1.w*entry);
    if(EXTRA_VECTOR4.w>.5){
        float boundary=abs(dot(ray,normalize(EXTRA_VECTOR4.xyz+vec3(0,0,.0001))));
        float spark=pow(h(floor(ray*90.0+vec3(t*22.0))),12.0)*exp(-boundary*40.0);
        result+=mix(vec3(.9,.04,.08),vec3(.24,.46,1.0),.5+.5*sin(t*4.0+ray.y*15.0))*spark;
    }
    gl_FragColor=vec4(clamp(result,0.0,1.0),src.a);
}

// __multiversion__
precision highp float;
#include "fragmentVersionCentroidUV.h"
#include "uniformWorldConstants.h"
LAYOUT_BINDING(0) uniform sampler2D TEXTURE_0;
LAYOUT_BINDING(2) uniform sampler2D TEXTURE_2;
uniform vec4 EXTRA_VECTOR1; // centre / radius
uniform vec4 EXTRA_VECTOR2; // time / kind (0 infinity, 1 heal, 2 ground warning) / age / opacity
uniform vec4 EXTRA_VECTOR3; // aspect / tan / local first-person / reserved
uniform vec4 EXTRA_VECTOR4; // world up in view-space / reserved
float h(vec3 p){return fract(sin(dot(p,vec3(127.1,311.7,74.7)))*43758.5453);}
float dep(float d){return abs(PROJ[3][2]/max(.000001,abs(d*2.0-1.0+PROJ[2][2])));}
void main(){
    vec4 src=texture2D(TEXTURE_0,uv);vec3 c=EXTRA_VECTOR1.xyz;
    float r=max(.1,EXTRA_VECTOR1.w),t=EXTRA_VECTOR2.x,kind=EXTRA_VECTOR2.y,fade=EXTRA_VECTOR2.w;
    vec2 screen=(uv*2.0-1.0)*vec2(EXTRA_VECTOR3.x,1.0)*EXTRA_VECTOR3.y;
    vec3 ray=normalize(vec3(screen,1.0));float raw=texture2D(TEXTURE_2,uv).r,terrain=raw>.99999?100000.0:dep(raw);
    vec3 color=kind<.5?vec3(.86,.95,1.0):vec3(.23,1.0,.41);float intensity=0.0;
    if(kind>1.5){
        vec3 up=normalize(EXTRA_VECTOR4.xyz+vec3(0,.00001,0));
        float denom=dot(ray,up),dist=dot(c,up)/denom;
        vec3 at=ray*dist-c;float radius=length(at);
        float band=exp(-abs(radius-r)*9.0)+exp(-abs(radius-r+.65)*18.0)*.3;
        intensity=band*step(0.0,dist)*step(dist*ray.z,terrain+.4)*fade;
        color=vec3(.68,.18,1.0);
    }else{
        vec2 q=(screen-c.xy/max(.1,c.z))*max(.1,c.z)/r;
        if(EXTRA_VECTOR3.z>.5)q=(uv-.5)*vec2(1.25,1.0)*2.0;
        float radius=length(q*vec2(1.0,.7));
        float ring=exp(-abs(radius-.91)*45.0);
        float flow=.5+.5*sin(atan(q.y,q.x)*5.0+t*7.0+sin(radius*15.0-t*4.0));
        float visibility=EXTRA_VECTOR3.z>.5?1.0:step(c.z-r*.5,terrain)*step(0.0,c.z);
        intensity=ring*(.4+.6*flow)*fade*visibility;
        if(kind>.5){
            for(int i=0;i<5;i++){
                float fi=float(i),seed=h(vec3(fi,6,2));
                vec2 at=vec2((seed-.5)*2.8,fract(seed*4.0-t*.28)*2.4-1.2);
                vec2 p=abs(q-at);float size=.08+seed*.045;
                float plus=max((1.0-smoothstep(.02,.032,p.x))*(1.0-smoothstep(size,size+.02,p.y)),(1.0-smoothstep(.02,.032,p.y))*(1.0-smoothstep(size,size+.02,p.x)));
                intensity+=plus*fade*visibility*.8;
            }
        }
    }
    gl_FragColor=vec4(clamp(src.rgb+color*intensity,0.0,1.0),src.a);
}
